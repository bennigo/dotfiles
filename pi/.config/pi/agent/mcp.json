{
  "mcpServers": {
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp",
      "exposure": "deferred",
      "description": "AI question-answering over any GitHub repository's documentation"
    },
    "chrome_devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.6.0"
      ],
      "exposure": "deferred",
      "description": "Chrome DevTools browser automation for reading JS-heavy pages"
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp@3.30.0"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "exposure": "deferred",
      "description": "Firecrawl web scrape/search/crawl/extract"
    }
  }
}
