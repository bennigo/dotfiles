{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,

  "yoloMode": true,
  "doublePressToConfirm": false,

  "permission": {
    "*": "allow",

    "path": {
      "*": "allow",

      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*pgpass": "deny",
      "*netrc": "deny",
      "*auth.json": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kdbx": "deny",
      "*.vault": "deny",

      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/id_ecdsa*": "deny",
      "**/*_key": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.password-store/*": "deny",
      "~/.aws/*": "deny",
      "~/.docker/config.json": "deny",
      "~/.local/share/keyrings/*": "deny",
      "**/.credentials_and_logins/**": "deny",
      "**/.cloudflared/**": "deny",
      "/etc/shadow": "deny",
      "/etc/gshadow": "deny",
      "/etc/sudoers": "deny"
    },

    "bash": { "*": "allow" },
    "mcp": { "*": "allow" },
    "skill": { "*": "allow" },

    "external_directory": { "*": "allow" }
  }
}
