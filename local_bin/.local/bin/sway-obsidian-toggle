#!/usr/bin/env bash
# sway-obsidian-toggle — $mod+Shift+o: go to Obsidian on workspace 7.
#
# Obsidian is a normal window on workspace 7 (sway `assign`; at work workspace 7
# is on the right screen — sway/scripts/workspace-layout.sh). Pressing again
# while on workspace 7 returns to the previous workspace. Not running → launch
# (the assign places it on 7) and go there.
#
# Until 2026-11-04 this toggled an Obsidian scratchpad window; see git history.
set -uo pipefail

LOG="${XDG_RUNTIME_DIR:-/tmp}/sway-obsidian-toggle.log"
WS=7
_log() { echo "[$(date '+%H:%M:%S')] $*" >> "$LOG"; }

_has_window() {
    swaymsg -t get_tree \
        | jq -r '.. | (.app_id? // empty), (.window_properties?.class? // empty)' 2>/dev/null \
        | grep -qi 'obsidian'
}

focused=$(swaymsg -t get_workspaces -r | jq -r '.[] | select(.focused) | .name')

if ! _has_window; then
    _log "no window — launching obsidian-launch"
    /home/bgo/.local/bin/obsidian-launch &
    swaymsg -q "workspace number $WS"
elif [[ "$focused" == "$WS" ]]; then
    _log "on workspace $WS — going back"
    swaymsg -q "workspace back_and_forth"
else
    _log "going to workspace $WS"
    swaymsg -q "workspace number $WS"
fi
