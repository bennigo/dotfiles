#!/bin/bash
## Herdr // renumber tab labels to match the keys that reach them // 🔢 ##
#
# Prepends "{number}. " to each tab label so tabs read "1. main", "2. claude",
# "9. test" — the number being herdr's PUBLIC TAB NUMBER, which is what
# ctrl+a 1..9 actually addresses. Without this the labels lie as soon as a tab
# has been closed, because herdr numbers tabs monotonically and never reuses a
# closed number:
#
#   w6  numbers = 1,2,3,9,10   labels = "1. claude","2. pi","3. zsh","test","epos…"
#       -> ctrl+a 4 and 5 reach NOTHING, "test" is really ctrl+a 9, and
#          "epos…" (number 10) is out of the 1..9 range entirely
#
# herdr exposes no renumber or reorder command (`herdr tab` is only
# list/create/get/focus/rename/close), so labels are the only place the truth
# can be surfaced. After running this, the label tells you which key to press.
#
# Idempotent: tabs that already carry the correct "N. " prefix are skipped.
# Tabs with a bare default number label are skipped too (name them first with
# ctrl+a Shift+T, then renumber).
#
# Bind: prefix+alt+n  (ctrl+a Alt+n)  -> focused workspace
# Run:  herdr-renumber-tabs                    # focused workspace
#       herdr-renumber-tabs w6 wE wM           # named workspaces, no focus change
#       herdr-renumber-tabs receivers dotfiles # labels work as well as ids

set -euo pipefail

# ── resolve targets: explicit args (workspace id or label), else the focused one
TARGETS=$(python3 - "$@" <<'PY'
import json, subprocess, sys

r = subprocess.run(['herdr', 'workspace', 'list'], capture_output=True, text=True)
try:
    ws_list = json.loads(r.stdout)['result']['workspaces']
except Exception:
    ws_list = []

if len(sys.argv) > 1:
    by_id = {w['workspace_id']: w for w in ws_list}
    by_label = {}
    for w in ws_list:
        by_label.setdefault(w.get('label', ''), w)
    found, missing = [], []
    for name in sys.argv[1:]:
        w = by_id.get(name) or by_label.get(name)
        if w:
            found.append(w['workspace_id'])
        else:
            missing.append(name)
    if missing:
        print('unknown workspace(s): ' + ', '.join(missing), file=sys.stderr)
    print('\n'.join(found))
else:
    foc = [w['workspace_id'] for w in ws_list if w.get('focused')]
    if not foc:
        print('no focused workspace', file=sys.stderr)
        sys.exit(1)
    print('\n'.join(foc))
PY
)

[ -n "$TARGETS" ] || { echo "no target workspace" >&2; exit 1; }

# ── renumber each target ────────────────────────────────────────────────────
while IFS= read -r WS; do
    [ -n "$WS" ] || continue
    python3 - "$WS" <<'PY'
import json, subprocess, re, sys

def run(args):
    '''Run a command via subprocess with argv list (no shell — prevents
    command injection from attacker-controlled tab labels).'''
    r = subprocess.run(args, capture_output=True, text=True)
    return json.loads(r.stdout) if r.stdout else {}

focused = sys.argv[1]

# List tabs in the target workspace
tab_data = run(['herdr', 'tab', 'list', '--workspace', focused])
tabs = tab_data.get('result',{}).get('tabs',[])
count = 0
for t in tabs:
    tid = t.get('tab_id','')
    num = t.get('number',0)
    label = t.get('label','')

    # Already correctly numbered? Skip
    if re.match(rf'^{num}\. ', label):
        continue
    # Bare default number? Skip (needs a name first)
    if label == str(num):
        continue

    # Strip wrong prefix, then prepend correct one
    clean = re.sub(r'^[0-9]+\. ', '', label)
    new = f'{num}. {clean}'
    # argv list — new (from label) is passed as a literal, never interpreted by a shell
    run(['herdr', 'tab', 'rename', tid, new])
    count += 1

print(f'renumbered {count} tab(s) in workspace {focused}')
PY
done <<<"$TARGETS"
