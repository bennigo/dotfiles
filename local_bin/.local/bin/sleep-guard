#!/usr/bin/env bash
# sleep-guard — run a systemctl sleep action and say so when it is refused.
#
# Usage: sleep-guard [--screen-off] [suspend-then-hibernate|hibernate|suspend]
#
# A logind *block* inhibitor (apt while dpkg runs, a sync job wrapped in
# systemd-inhibit, ...) makes `systemctl suspend-then-hibernate` fail at once,
# and every caller (sway keys, swayidle, lid scripts, udev) dropped the error.
# 2026-11-20: apt sat at a debconf prompt all day holding "APT is installing
# or removing packages"; three sleep attempts were refused silently and the
# battery ran flat. This wrapper sends a critical notification that names the
# blocker, and with --screen-off it turns the outputs off before sleeping and
# back on if sleep is refused (otherwise the screen stays black).
#
# Works as the desktop user and as root (udev/systemd-run): as root it
# delivers the notification to every logged-in user's session bus.

set -uo pipefail

screen_off=0
if [[ "${1:-}" == --screen-off ]]; then screen_off=1; shift; fi
action="${1:-suspend-then-hibernate}"
case "$action" in
    suspend-then-hibernate|hibernate|suspend) ;;
    *) echo "sleep-guard: unknown action '$action'" >&2; exit 2 ;;
esac

if (( screen_off )) && [[ -n "${SWAYSOCK:-}" ]]; then
    # Outputs off first so the NVIDIA modeset engine is idle when the GPU
    # enters its suspend path (avoids the "waiting for GPU progress" hang).
    swaymsg 'output * power off' >/dev/null 2>&1 || true
    sleep 0.3
fi

err=$(systemctl "$action" 2>&1)
rc=$?
(( rc == 0 )) && exit 0

# "already in progress": the system is mid-sleep, not refusing it. Happens at
# the suspend-then-hibernate estimation wake (2026-11-24/25): AC unplugged
# while asleep -> udev -> lid-ac-suspend-check calls us seconds before
# systemd-sleep hibernates. Log only; no notification, and the outputs stay
# off because sleep is going ahead.
if [[ $err == *"already in progress"* ]]; then
    logger -t sleep-guard "$action requested while a sleep operation is already in progress — ignored"
    exit 0
fi

if (( screen_off )) && [[ -n "${SWAYSOCK:-}" ]]; then
    swaymsg 'output * power on' >/dev/null 2>&1 || true
fi

# Who holds a block inhibitor on sleep? "who: why" per line.
blockers=$(busctl --json=short call org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager ListInhibitors 2>/dev/null |
    jq -r '.data[0][] | select(.[3]=="block" and (.[0]|split(":")|index("sleep"))) | "\(.[1]): \(.[2])"' 2>/dev/null)

title="Svefni hafnað ($action)"
if [[ -n "$blockers" ]]; then
    body="Blokkað af: ${blockers//$'\n'/; }"
else
    body="${err:-systemctl $action skilaði $rc}"
fi
logger -t sleep-guard "$title — $body"

notify() {
    if (( EUID != 0 )); then
        notify-send -u critical -t 0 -a sleep-guard "$title" "$body" 2>/dev/null || true
        return
    fi
    local bus uid user
    for bus in /run/user/*/bus; do
        [[ -S "$bus" ]] || continue
        uid=${bus#/run/user/}; uid=${uid%/bus}
        user=$(id -nu "$uid" 2>/dev/null) || continue
        runuser -u "$user" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
            notify-send -u critical -t 0 -a sleep-guard "$title" "$body" 2>/dev/null || true
    done
}
notify
exit "$rc"
