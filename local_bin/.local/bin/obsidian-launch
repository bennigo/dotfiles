#!/usr/bin/env bash
# Launch the Obsidian snap.
#
# The snap restructured in Aug 2026 (revision 67, base: core24, classic
# confinement): it no longer ships desktop-common.sh / desktop-gnome-specific.sh.
# Its command.sh is now just `exec "$SNAP/app/obsidian" "$@"`, and snapd sets the
# snap env itself — so we route through /snap/bin/obsidian instead of hand-rolling
# the SNAP_* environment.
#
# Flags preserved for this machine (Sway/Wayland + NVIDIA RTX 2000 Ada):
#   --no-sandbox                chrome-sandbox is not setuid in the classic snap
#   --ozone-platform=wayland    native Wayland on Sway (avoid XWayland)
#   --disable-features=UseWebGPU  avoid GPU/WebGPU rendering crashes
exec /snap/bin/obsidian \
    --no-sandbox \
    --ozone-platform=wayland \
    --disable-features=UseWebGPU \
    "$@"
