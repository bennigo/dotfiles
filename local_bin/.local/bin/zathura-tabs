#!/usr/bin/env python3
"""Open a directory's PDFs as Sway tabs, leaving ordinary Zathura in the scratchpad."""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

APP_ID = "org.pwmt.zathura"


def pdf_files(paths):
    """Accept one directory (non-recursive) or explicit PDF paths; preserve file order."""
    entries = [Path(value).expanduser().resolve(strict=True) for value in (paths or ["."])]
    if len(entries) == 1 and entries[0].is_dir():
        entries = sorted(entries[0].iterdir(), key=lambda path: path.name.casefold())
        entries = [path for path in entries if path.is_file() and path.suffix.lower() == ".pdf"]
    if not entries:
        raise ValueError("No PDFs found in the selected directory.")
    for path in entries:
        if not path.is_file() or path.suffix.lower() != ".pdf":
            raise ValueError(f"Not a PDF file: {path}")
    return list(dict.fromkeys(entries))


def sway(*arguments):
    result = subprocess.run(
        ["swaymsg", "-r", *arguments], check=True, capture_output=True, text=True, timeout=10
    )
    reply = json.loads(result.stdout)
    if isinstance(reply, list):
        for item in reply:
            if not item.get("success", False):
                raise RuntimeError(item.get("error", "Sway command failed"))
    return reply


def window_for_pid(tree, pid):
    if tree.get("pid") == pid and tree.get("app_id") == APP_ID:
        return tree["id"]
    for child in tree.get("nodes", []) + tree.get("floating_nodes", []):
        found = window_for_pid(child, pid)
        if found is not None:
            return found
    return None


def open_pdf(path):
    # One process per file gives us an exact PID: never move an existing reader
    # or another application's window, and never interpolate filenames into IPC.
    process = subprocess.Popen(
        ["zathura", str(path)], stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
    )
    try:
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline:
            window = window_for_pid(sway("-t", "get_tree"), process.pid)
            if window is not None:
                return window
            if process.poll() is not None:
                raise RuntimeError(f"Zathura exited before opening {path.name}.")
            time.sleep(0.1)
        raise RuntimeError(f"Timed out waiting for Zathura to open {path.name}.")
    except BaseException:
        # Only terminate the new, unmapped process on failure. Already opened
        # documents are left alone if a subsequent file fails.
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=3)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()
        raise


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("paths", nargs="*", metavar="DIRECTORY_OR_PDF",
                        help="one directory, or PDF files; defaults to the current directory")
    parser.add_argument("--workspace", default="pdfs", help="dedicated Sway workspace (default: pdfs)")
    args = parser.parse_args(argv)
    try:
        files = pdf_files(args.paths)
        if not args.workspace or any(ord(char) < 32 for char in args.workspace):
            raise ValueError("Workspace name must be nonempty and contain no control characters.")
        if not os.environ.get("SWAYSOCK"):
            raise RuntimeError("Run this launcher inside a Sway session.")
        for command in ("swaymsg", "zathura"):
            if not shutil.which(command):
                raise RuntimeError(f"Required command not found: {command}")
        workspace = json.dumps(args.workspace)
        # This is a dedicated browsing workspace, not the terminal's container.
        sway(f"workspace {workspace}; layout tabbed")
        windows = []
        for path in files:
            window = open_pdf(path)
            sway(f"[con_id={window}] move container to workspace {workspace}, floating disable")
            windows.append(window)
        sway(f"workspace {workspace}; [con_id={windows[0]}] focus")
        print(f"Opened {len(windows)} PDFs on workspace {args.workspace!r}.")
        print("Switch PDFs: Super+h / Super+l (or Super+Left / Super+Right).")
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"zathura-tabs: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
