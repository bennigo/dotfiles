#!/usr/bin/env bash
# Additive sync of IMO monitoring data from /mnt_data to the gogn external drive.
#
# gogn keeps data the servers no longer have (they prune and move old years),
# so this must NEVER use --delete, and a file the server changed is kept under
# <dataset>/.rsync-replaced/<date>/ instead of being overwritten.
#
# Usage: gogn-sync-imo [--full] [--years FROM-TO]
#   default  hytrodata + the current year of sildata and tremdata (daily timer)
#   --full   everything, sildata year by year with the newest first, so a dropped
#            VPN costs the least (sildata is ~12M files, so this takes many hours)
#   --years  only these sildata years (implies --full), e.g. 2018- or 2001-2001
#
# extension_meters_data is left out while its server side is broken.
set -uo pipefail

FULL=0
YMIN=0
YMAX=9999
while [ $# -gt 0 ]; do
    case $1 in
        --full) FULL=1 ;;
        --years)
            FULL=1
            [[ ${2:-} =~ ^([0-9]{4})?-([0-9]{4})?$ ]] || { echo "gogn-sync-imo: --years FROM-TO" >&2; exit 2; }
            YMIN=${BASH_REMATCH[1]:-0}
            YMAX=${BASH_REMATCH[2]:-9999}
            shift
            ;;
        *) echo "usage: gogn-sync-imo [--full] [--years FROM-TO]" >&2; exit 2 ;;
    esac
    shift
done

GOGN="${GOGN_MOUNT:-/run/media/bgo/gogn}"
DEST="$GOGN/mnt_data"
SRC=/mnt_data
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/gogn-sync-imo"
TODAY=$(date +%F)
WORST=0
EXTRA=()

mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/$TODAY.log"

exec 9>"$LOG_DIR/lock"
flock -n 9 || { echo "gogn-sync-imo: already running" >&2; exit 0; }

mountpoint -q "$GOGN" || { echo "gogn-sync-imo: $GOGN not mounted" >&2; exit 0; }
# udisks remounts gogn at the same path after a USB drop, but as a new device
GOGN_DEV=$(stat -c %d "$GOGN")

reachable() { timeout 60 test -d "$SRC/sildata/$(date +%Y)"; }

# stop <reason> <part>
stop() {
    echo "=== $(date '+%F %T') $1 during $2, stopping" >>"$LOG"
    notify-send -u normal -t 0 "gogn-sync-imo" "Stopped: $1 during $2, see $LOG"
    exit 1
}

# copy <dataset> [subpath]
copy() {
    local dataset=$1 sub=${2:-} rc
    local from="$SRC/$dataset/$sub" to="$DEST/$dataset/$sub"

    # A missing subpath is normal (a station with no data this year)
    timeout 60 test -d "$from" || return 0

    echo "=== $(date '+%F %T') $dataset/$sub" >>"$LOG"
    rsync -rlt --mkpath --timeout=300 --bwlimit=30m \
        --backup --backup-dir="$DEST/$dataset/.rsync-replaced/$TODAY/$sub" \
        --stats --log-file="$LOG" --log-file-format='%i %n' "${EXTRA[@]}" \
        "${from%/}/" "${to%/}/" >>"$LOG" 2>&1
    rc=$?
    # gogn is a shuttle drive: make this part durable before starting the next
    sync -f "$DEST"
    echo "=== $(date '+%F %T') $dataset/$sub rc=$rc" >>"$LOG"
    # 24 = files vanished during the transfer, normal on live data
    [ "$rc" -ne 0 ] && [ "$rc" -ne 24 ] && WORST=$rc

    # A lost server or drive looks like rc 23, the same as a few unreadable files
    if ! mountpoint -q "$GOGN" || [ "$(stat -c %d "$GOGN")" != "$GOGN_DEV" ]; then
        stop "gogn dropped (check the filesystem, then rerun this part)" "$dataset/$sub"
    fi
    reachable || stop "$SRC lost (VPN?)" "$dataset/$sub"
    return 0
}

if ! reachable; then
    echo "gogn-sync-imo: $SRC not reachable" >&2
    exit 0
fi

copy hytrodata

if [ "$FULL" = 1 ]; then
    copy tremdata
    # gogn's older sildata has 2019 copy-time mtimes, so a normal size+mtime check
    # would re-copy all ~12M files. Event files never change once written, and
    # unlike --ignore-existing this re-fetches 0-byte files left by a USB drop.
    # (--fsync on each file also protects against that, but limits us to ~10 files/s.)
    EXTRA=(--size-only)
    for dir in $(printf '%s\n' "$SRC"/sildata/[12][0-9][0-9][0-9]/ | sort -r); do
        year=$(basename "$dir")
        [ "$year" -ge "$YMIN" ] && [ "$year" -le "$YMAX" ] && copy sildata "$year"
    done
    # Whatever is left at the top level (alert, projects, ...)
    EXTRA=(--size-only --exclude='/[12][0-9][0-9][0-9]/')
    copy sildata
    EXTRA=()
else
    # Also last year's directory during the first week of January
    for year in $(printf '%s\n' "$(date +%Y)" "$(date -d '7 days ago' +%Y)" | sort -u); do
        copy tremdata "$year"
        for station in al3 ph6 sh1 sh2 tr1; do
            copy tremdata "$station/$year"
        done
        copy sildata "$year"
    done
fi

if [ "$WORST" -ne 0 ]; then
    notify-send -u normal -t 0 "gogn-sync-imo" "Finished with errors (rsync $WORST), see $LOG"
fi
exit "$WORST"
