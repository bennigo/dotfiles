#!/bin/bash
# herdr-ws-track — background tracker for focused-workspace history.
# Polls `herdr workspace list` and records focus changes to a history file
# (most-recent-first, deduped, capped). Started on-demand by herdr-ws-toggle.
#
# Single-instance via flock. Lightweight: one local socket call per second.

HERDR="${HERDR_BIN_PATH:-herdr}"
CACHE_DIR="$HOME/.cache/herdr"
HIST_FILE="$CACHE_DIR/ws-history"
LOCK_FILE="$CACHE_DIR/ws-track.lock"
INTERVAL=1   # seconds between polls

mkdir -p "$CACHE_DIR"

# Ensure only one tracker runs
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

# Write PID file for fast health checks by herdr-ws-toggle
echo $$ > "$CACHE_DIR/ws-track.pid"

# Seed history on first run so the toggle always has candidates.
# (Real recency replaces this within a few workspace switches.)
if [ ! -f "$HIST_FILE" ]; then
    "$HERDR" workspace list 2>/dev/null | python3 -c "
import json, sys
path = sys.argv[1]
try:
    d = json.load(sys.stdin)
    ws = sorted(d['result']['workspaces'], key=lambda w: w.get('number', 0))
    open(path, 'w').write('\n'.join(w['workspace_id'] for w in ws) + '\n')
except Exception:
    open(path, 'w').close()
" "$HIST_FILE"
fi

last_focused=""

while true; do
    focused=$("$HERDR" workspace list 2>/dev/null | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    for w in d['result']['workspaces']:
        if w.get('focused'):
            print(w['workspace_id']); break
except Exception:
    pass
")

    if [ -n "$focused" ] && [ "$focused" != "$last_focused" ]; then
        last_focused="$focused"
        # Prepend to history, dedupe, cap at 12
        python3 -c "
import sys
path, new = sys.argv[1], sys.argv[2]
try:
    hist = open(path).read().split()
except FileNotFoundError:
    hist = []
hist = [new] + [h for h in hist if h != new]
open(path, 'w').write('\n'.join(hist[:12]) + '\n')
" "$HIST_FILE" "$focused"
    fi
    sleep "$INTERVAL"
done
