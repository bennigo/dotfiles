#!/bin/bash
# herdr-tab-reorder — open floating foot window for tab reorder.
# Wraps the popup in error-catching bash so failures stay visible.
exec foot --title "Tab Reorder" --window-size-chars=56x14 bash -c '
set -euo pipefail

# ── Get focused workspace ──
WS=$(herdr workspace list 2>/dev/null | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    ws_list = data.get(\"result\",{}).get(\"workspaces\",[]) or data.get(\"workspaces\",[])
    focused = [w for w in ws_list if w.get(\"focused\")]
    print(focused[0][\"id\"] if focused else \"\")
except: pass
" 2>/dev/null)

if [ -z "$WS" ]; then
    echo "ERROR: Could not find focused workspace."
    echo "  HERDR_SOCKET_PATH=${HERDR_SOCKET_PATH:-unset}"
    echo "  PATH=$PATH"
    read -p "Press Enter to close…"
    exit 1
fi

# ── Run popup, catch errors ──
~/.local/bin/herdr-tab-reorder-popup "$WS" || {
    rc=$?
    echo
    echo "Popup exited with code $rc"
    read -p "Press Enter to close…"
    exit $rc
}
' 2>/dev/null
