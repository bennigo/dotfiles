#!/bin/sh
# Sway session launcher used by GDM (/usr/share/wayland-sessions/sway.desktop: Exec=sway-debug).
# /usr/local/bin/sway-debug is a symlink to this file so GDM's PATH finds it.
# stderr is kept in ~/.local/share/sway/sway-session.log (previous session: .log.prev).
LOGDIR=/home/bgo/.local/share/sway
mkdir -p "$LOGDIR"
mv "$LOGDIR/sway-session.log" "$LOGDIR/sway-session.log.prev" 2>/dev/null || true

# Legacy (non-atomic) KMS made the DisplayLink dock output fail with
# drmModePageFlip EBUSY at login, leaving sway with no outputs (2026-11-04).
# Atomic is the default; unset explicitly so a stale environment.d/user-manager
# value can't sneak it back in.
# Escape hatch from a TTY if the old NVIDIA issue returns: touch ~/.config/sway/legacy-kms
unset WLR_DRM_NO_ATOMIC
[ -e /home/bgo/.config/sway/legacy-kms ] && export WLR_DRM_NO_ATOMIC=1

exec sway --unsupported-gpu 2>"$LOGDIR/sway-session.log"
