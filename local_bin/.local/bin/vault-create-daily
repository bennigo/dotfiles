#!/usr/bin/env bash
# vault-create-daily — Create daily note from canonical template (standalone)
# Single source of truth for daily note creation outside Obsidian.
# Used by: vault-jot, /daily slash command
# Inside Obsidian: Templater folder template handles creation instead.
#
# Usage: vault-create-daily YYYY-MM-DD
#        vault-create-daily          # defaults to today

set -euo pipefail

NOTE_DATE="${1:-$(date +%Y-%m-%d)}"
VAULT_DIR="${HOME}/notes/bgovault"
DAILY_DIR="${VAULT_DIR}/Journal/daily"
NOTE_FILE="${DAILY_DIR}/${NOTE_DATE}.md"

# Already exists — nothing to do
[[ -f "${NOTE_FILE}" ]] && exit 0

# ── Adopt a note another writer already created + pushed for this date ──────
# A /morning (or another Claude/Pi session) run can create AND push today's
# note before the 07:30 prewarm gets here. Creating a second local copy makes
# the next `git pull` abort with "untracked working tree files would be
# overwritten" (2026-09-16). Adopt the pushed note instead of racing it.
if git -C "${VAULT_DIR}" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "${VAULT_DIR}" fetch origin --quiet 2>/dev/null || true
    if git -C "${VAULT_DIR}" cat-file -e "origin/main:Journal/daily/${NOTE_DATE}.md" 2>/dev/null; then
        if git -C "${VAULT_DIR}" checkout origin/main -- "Journal/daily/${NOTE_DATE}.md" 2>/dev/null; then
            echo "vault-create-daily: adopted origin/main:Journal/daily/${NOTE_DATE}.md (created by another session)" >&2
            exit 0
        fi
    fi
fi

# ── Rollover uncompleted tasks from most recent previous daily note ───
# Mirrors obsidian-rollover-daily-todos plugin behavior for notes created
# outside Obsidian (Neovim, CLI). Finds tasks under "## Verkefni dagsins"
# (before "### Áætlað í dag"), rolls over uncompleted ones, removes from source.
rollover_tasks() {
    local target_file="$1"
    local target_date="$2"

    # Find most recent previous daily note (walk back up to 7 days)
    local prev_file=""
    for i in $(seq 1 7); do
        local check_date
        check_date=$(date -d "${target_date} - ${i} day" +%Y-%m-%d)
        local check_file="${DAILY_DIR}/${check_date}.md"
        if [[ -f "${check_file}" ]]; then
            prev_file="${check_file}"
            break
        fi
    done
    [[ -z "${prev_file}" ]] && return 0

    # Extract line range: from "## Verkefni dagsins" to "### Áætlað í dag"
    local section_start section_end
    section_start=$(grep -n '^## Verkefni dagsins$' "${prev_file}" | head -1 | cut -d: -f1)
    [[ -z "${section_start}" ]] && return 0
    section_end=$(tail -n +"$((section_start + 1))" "${prev_file}" | grep -n '^### ' | head -1 | cut -d: -f1)
    if [[ -n "${section_end}" ]]; then
        section_end=$((section_start + section_end - 1))
    else
        # No ### subheading — use next ## heading as boundary
        section_end=$(tail -n +"$((section_start + 1))" "${prev_file}" | grep -n '^## ' | head -1 | cut -d: -f1)
        if [[ -n "${section_end}" ]]; then
            section_end=$((section_start + section_end - 1))
        else
            section_end=$(wc -l < "${prev_file}")
        fi
    fi

    # Collect uncompleted tasks and their children from the section
    local tasks=()
    local in_task=false
    local line_num=$((section_start + 1))

    while [[ ${line_num} -le ${section_end} ]]; do
        local line
        line=$(sed -n "${line_num}p" "${prev_file}")

        if [[ "${line}" =~ ^-\ \[\ \]\ (.+) ]]; then
            # Uncompleted task — check it's not empty
            local task_text="${BASH_REMATCH[1]}"
            task_text=$(echo "${task_text}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            if [[ -n "${task_text}" ]]; then
                in_task=true
                tasks+=("${line}")
            else
                in_task=false
            fi
        elif [[ "${line}" =~ ^-\ \[[xX/\-]\] ]]; then
            # Completed/cancelled task — skip
            in_task=false
        elif ${in_task} && [[ "${line}" =~ ^[[:space:]]+ ]]; then
            # Indented child line of current task
            tasks+=("${line}")
        else
            in_task=false
        fi

        line_num=$((line_num + 1))
    done

    [[ ${#tasks[@]} -eq 0 ]] && return 0

    # Insert rolled-over tasks into new note under "## Verkefni dagsins"
    local insert_point
    insert_point=$(grep -n '^## Verkefni dagsins$' "${target_file}" | head -1 | cut -d: -f1)
    [[ -z "${insert_point}" ]] && return 0

    # Insert rolled-over tasks into new note (non-destructive — source note untouched
    # to avoid racing with Obsidian Sync between phone and laptop)
    local tmpfile
    tmpfile=$(mktemp)
    printf '%s\n' "${tasks[@]}" > "${tmpfile}"
    sed -i "$((insert_point))r ${tmpfile}" "${target_file}"
    rm -f "${tmpfile}"
}

# Compute template values
ALIAS=$(date -d "${NOTE_DATE}" +"📅 %B %-d, %Y day: %j")
NOW=$(date +%H:%M)
CREATED=$(date +"%Y-%m-%d %H:%M")

cat > "${NOTE_FILE}" <<FRONTMATTER
---
area: "Journal"
id: ${NOTE_DATE}
created: ${CREATED}
aliases:
  - "${ALIAS}"
tags:
  - type/daily-note
project: ""
resource: ""
---
FRONTMATTER

# ── Body: render the CANONICAL template — one source of truth ────────────────
# Templates/template_daily.md is what Obsidian's Templater applies to a new note
# in Journal/daily. This CLI used to carry its own copy of the body, and the two
# drifted badly: the CLI had the /morning-v2 sections, the Templater template did
# not, and the notes actually created matched NEITHER. Render the one source.
#
# Templater is an Obsidian-only runtime, so the few expressions the template uses
# are substituted here; anything left unsubstituted is a hard error (this vault
# has already shipped literal "(CCYY-MM-DDThh:mmZ)" placeholders once).
# The trailing <%* ... %> hook is dropped — it calls
# app.commands.executeCommandById(...), meaningless outside Obsidian. Rollover is
# handled natively by rollover_tasks() below.
TEMPLATE_FILE="${VAULT_DIR}/Templates/template_daily.md"
if [[ ! -f "${TEMPLATE_FILE}" ]]; then
    echo "vault-create-daily: missing ${TEMPLATE_FILE}" >&2
    exit 1
fi
NOTE_DATE="${NOTE_DATE}" NOW="${NOW}" python3 - "${TEMPLATE_FILE}" >> "${NOTE_FILE}" <<'PYRENDER'
import os, re, sys
from datetime import date, timedelta

tpl = open(sys.argv[1], encoding="utf-8").read()

# Body only — the frontmatter above is generated here, not by the template.
m = re.match(r"^---\n.*?\n---\n", tpl, re.S)
body = tpl[m.end():] if m else tpl

day = date.fromisoformat(os.environ["NOTE_DATE"])
shift = lambda n: (day + timedelta(days=n)).isoformat()

for pattern, value in (
    (r'<% tp\.date\.now\("YYYY-MM-DD", -1, tp\.file\.title, "YYYY-MM-DD"\) %>', shift(-1)),
    (r'<% tp\.date\.now\("YYYY-MM-DD", 1, tp\.file\.title, "YYYY-MM-DD"\) %>', shift(1)),
    (r'<% tp\.date\.now\("YYYY-MM-DD", -6, tp\.file\.title, "YYYY-MM-DD"\) %>', shift(-6)),
    (r'<% tp\.date\.now\("HH:mm"\) %>', os.environ["NOW"]),
    (r'<% tp\.file\.title %>', os.environ["NOTE_DATE"]),
):
    body = re.sub(pattern, value, body)

# Drop the Obsidian-only rollover hook.
body = re.sub(r"\n*<%\*.*?%>\s*$", "\n", body, flags=re.S)

left = re.findall(r"<%.*?%>", body, re.S)
if left:
    sys.exit(f"vault-create-daily: unsubstituted Templater expression(s): {left}")

sys.stdout.write(body)
PYRENDER

# Roll over uncompleted tasks from previous daily note
rollover_tasks "${NOTE_FILE}" "${NOTE_DATE}"
