#!/usr/bin/env bash
# morning-prewarm — Pre-warm the daily note before the manual /morning-v2 run.
#
# 1. Syncs the repo, then creates today's daily note (vault-create-daily; no-op if
#    it exists — the remote routine usually created and pushed it already)
# 2. Injects a market one-liner under the title (idempotent — skipped if present)
# 3. Sends a reminder notification to run /morning-v2 (the geopolitics scan
#    itself stays manual/LLM-driven — Claude Code or Pi)
#
# Fired by morning-prewarm.timer (weekdays 07:30).

set -uo pipefail

VAULT_DIR="$HOME/notes/bgovault"
NOTE="$VAULT_DIR/Journal/daily/$(date +%F).md"

# ── 0. Sync BEFORE creating the note ───────────────────────────────────────
# The remote morning-briefing routine (07:00, a separate clone) creates AND PUSHES
# this same daily note. Creating it locally first leaves it untracked here, and git
# then refuses to merge origin's version — "error: The following untracked working
# tree files would be overwritten by merge: Journal/…" — which in turn leaves the
# enriched commit unpushed for the rest of the day (seen 2026-09-25, 09-28, 10-01).
# Pull first, so vault-create-daily finds the note already present and no-ops.
# --no-rebase only: rebases are banned in this repo (see CLAUDE.md), and a paused
# git operation must not be walked over. Non-fatal by design.
if ! ls "$VAULT_DIR"/.git/MERGE_HEAD "$VAULT_DIR"/.git/rebase-merge \
        "$VAULT_DIR"/.git/rebase-apply "$VAULT_DIR"/.git/CHERRY_PICK_HEAD \
        "$VAULT_DIR"/.git/REVERT_HEAD >/dev/null 2>&1; then
    git -C "$VAULT_DIR" pull --no-rebase >/dev/null 2>&1 || \
        echo "prewarm: pre-pull failed (continuing; see morning-enrich.log)" >&2
fi

# ── 1. Daily note ────────────────────────────────────────────────────────────
"$HOME/.local/bin/vault-create-daily" >/dev/null 2>&1 || true

# ── 2. Market pulse ──────────────────────────────────────────────────────────
if [[ -f "$NOTE" ]] && ! grep -q '^\*\*Markets\*\*:' "$NOTE"; then
    json="$(cd "$VAULT_DIR" && uv run .scripts/market-tracker.py --json --no-plots 2>/dev/null)" || json=""
    if [[ -n "$json" ]]; then
        line="$(JSON="$json" python3 - <<'PYEOF'
import json, os, sys
data = json.loads(os.environ["JSON"])
by = {i["name"]: i["current"] for i in data}
try:
    print("**Markets**: Brent ${:,.2f} · WTI ${:,.2f} · Gold ${:,.0f} · VIX {:.1f} · DXY {:.1f}".format(
        by["Brent Crude Oil"], by["WTI Crude Oil"], by["Gold"],
        by["VIX (Fear Index)"], by["US Dollar Index"]))
except KeyError as e:
    print(f"missing asset: {e}", file=sys.stderr)
    sys.exit(1)
PYEOF
)" || line=""
        if [[ -n "$line" ]]; then
            # Insert the market pulse directly under the "### 🌅 Morgunyfirlit — DATE"
            # heading, so it heads the morning summary.
            #
            # Until 2026-10-08 this anchored on the "# YYYY-MM-DD" title instead,
            # which put the line at the very top of the note — above the prev/next
            # nav links — and left the nav stranded under the market data. The
            # heading is the right anchor: it is written by vault-create-daily's
            # heredoc, so it exists before this runs.
            python3 - "$NOTE" "$line" <<'PYEOF'
import re, sys
path, line = sys.argv[1], sys.argv[2]
text = open(path).read()

# Preferred anchor: the Morgunyfirlit heading, matched as a full line.
pat = re.compile(r"(?m)^(###\s*🌅\s*Morgunyfirlit[^\n]*\n)")
new, n = pat.subn(lambda m: m.group(1) + "\n" + line + "\n", text, count=1)
if not n:
    # Fallback: no heading (older note shape) — keep the old title-anchored
    # behaviour rather than dropping the line.
    new, n = re.subn(r"(?m)^(# \d{4}-\d{2}-\d{2}\s*)$", "\\1\n\n" + line + "\n", text, count=1)
if n:
    open(path, "w").write(new)
else:
    print("no Morgunyfirlit heading and no title line — market line not injected", file=sys.stderr)
PYEOF
        fi
    fi
fi


# ── 4. Morning enrichment (A: todo links, B: P1 scan, C: overdue OL, D: market alerts) ──
python3 "$HOME/notes/bgovault/.scripts/morning-enrich/morning-enrich.py" "$(date +%F)" >> "$HOME/.cache/morning-enrich.log" 2>&1 || true

# ── 3. Reminder + durable marker ─────────────────────────────────────────────
# -a sets an app-name so the mako rule for "morning-prewarm" holds the popup on
# screen for a full minute (the default 5s was easy to miss).
notify-send -a morning-prewarm -u normal \
    "🌅 Morgunyfirlit tilbúið" \
    "Dagsnóta + markaðslína tilbúin — keyra /morning-v2 fyrir geopolitics scan" \
    2>/dev/null || true

# Durable record — mako keeps only a 5-entry history, so a missed popup leaves
# no trace that the briefing ran. Append a one-line marker instead.
LOG="$HOME/.cache/morning-prewarm.log"
printf '%s  briefing ready  note=%s\n' "$(date '+%Y-%m-%d %H:%M')" "$NOTE" >> "$LOG"
