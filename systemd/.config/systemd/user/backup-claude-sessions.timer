[Unit]
Description=Daily Claude session transcript backup

[Timer]
# Midday, when gpg-agent is unlocked (at 03:00 pass failed every night, BGÓ 2026-11-09);
# Persistent catches missed runs after sleep/boot
OnCalendar=*-*-* 12:00:00
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
