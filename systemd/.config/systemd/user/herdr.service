[Unit]
Description=herdr server (persistent agent workspace manager)
# No Documentation= line: herdr ships no man page, and `herdr --help` is not a
# valid URI for that key (systemd-analyze rejects it). See `herdr --help`
# directly, plus systemd/CLAUDE.md → "herdr persistence".
# Starts with the graphical session, not at login.
#
# A restore is eager: it respawns every saved pane at once (45 panes here, of
# which 11 are agents). Pulling that in front of the desktop would make login
# contend with 45 shell spawns and 11 agents starting their MCP servers. We are
# fine waiting for sway — the workspace is there as soon as a terminal is.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
# MUST run through a login shell.
#
# `systemctl --user` starts with a bare environment — PATH is only
# /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin, with no API keys
# (sway does not import-environment into systemd --user here). Paths and keys
# come from ~/.zshenv, which adds ~/.local/bin, cargo/npm, and sources
# ~/.config/zsh/api-keys.sh. Without this the server starts, but every restored
# claude/pi pane comes back without its binary on PATH or its credentials.
Type=simple
ExecStart=/bin/zsh -lc 'exec %h/.local/bin/herdr server'

# Take the resume-hints snapshot BEFORE stopping the server, while the agents
# are still running — `agent_session` records are only guaranteed to exist then,
# and herdr owns session.json and may rewrite it during a restore.
# Multiple ExecStop= lines run in order, so ordering here is load-bearing.
# With [session] resume_agents_on_restore=false (see herdr/config.toml), restored
# panes come back as plain shells, so this snapshot is how you find out which
# conversation each pane held.
ExecStop=%h/.local/bin/herdr-resume-hints --snapshot

# Then shut down through herdr's own socket API so panes are closed cleanly and
# session.json is flushed before the process exits. If it fails, systemd still
# terminates the unit after TimeoutStopSec.
ExecStop=%h/.local/bin/herdr server stop

Restart=on-failure
RestartSec=5

# SIGTERM to the server only; its pane children are reaped by herdr itself.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=graphical-session.target
