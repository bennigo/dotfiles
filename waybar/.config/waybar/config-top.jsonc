// Top bar — one waybar process, two bars (launch-top.sh supervises it).
// The full bar's content is wider than a portrait 1080p screen, and a
// layer-shell bar can't shrink below its content, so on the portrait Dell
// (DP-2, see kanshi config) it spilled onto the next screen. DP-2 gets a
// short bar instead. Module definitions live in top-modules.jsonc.
[
    {
        "output": "!DP-2",
        "include": "~/.dotfiles/waybar/.config/waybar/top-modules.jsonc",
        "layer": "top",
        "position": "top",
        "height": 30,
        "margin-top": 4,
        "margin-left": 10,
        "margin-right": 10,
        "spacing": 4,
        "modules-left": [
            "sway/workspaces",
            "custom/git-sync"
        ],
        "modules-center": [],
        "modules-right": [
            "custom/network",
            "custom/localip",
            "custom/pubip",
            "custom/vpn",
            "custom/sysmon",
            "custom/cpu",
            "custom/battery",
            "custom/brightness",
            "custom/volume",
            "custom/mic",
            "custom/recording",
            "custom/bluetooth",
            "clock",
            "custom/language",
            "custom/keep-awake",
            "custom/dnd",
            "custom/power"
        ]
    },
    {
        "output": "DP-2",
        "include": "~/.dotfiles/waybar/.config/waybar/top-modules.jsonc",
        "layer": "top",
        "position": "top",
        "height": 30,
        "margin-top": 4,
        "margin-left": 10,
        "margin-right": 10,
        "spacing": 4,
        "modules-left": [
            "sway/workspaces"
        ],
        "modules-center": [],
        "modules-right": [
            "custom/volume",
            "clock",
            "custom/language",
            "custom/power"
        ],
        // Only this screen's workspaces, so the list stays short.
        "sway/workspaces": {
            "disable-scroll": true,
            "all-outputs": false
        }
    }
]
